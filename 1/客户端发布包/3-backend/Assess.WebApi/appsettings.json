{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Debug", //最小日志记录级别
            "Override": { //系统日志最小记录级别
                "Default": "Warning",
                "System": "Warning",
                "Microsoft": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Async",
                "Args": {
                    "configure": [
                        {
                            "Name": "File", //输出文件
                            "Args": {
                                "path": "Logs/RunLog/log-.txt",
                                "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {Message}{NewLine}{Exception}",
                                "rollingInterval": "3" //日志文件生成精度：1：年  2：月 3：日 4：小时
                            }
                        }
                    ]
                }
            }
        ],
        "Enrich": [ "FromLogContext" ]
    },
    "AllowedOrigins": "*",
    "ConnectionStrings": {
        "MySqlConnection": "server=localhost;port=3306;database=assess;user=assess;password=ptKcesiCPYzhGdfR;allowPublicKeyRetrieval=true;pooling=true;charset=utf8mb4;sslMode=none;"
    },
    "TokenDuration": 30,
    "VerCodeDuration": 60,
    "UploadAddress": "https://api.cs4c.cn/uploads/",
    "UploadDirectory": "/uploads/",
    "UseSwaggerUI": true
}
